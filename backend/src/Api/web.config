<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        Host as dedicated site https://api.kbtglobal.app with its own Application Pool.
        BackgroundService (order/listing sync, Telegram) runs in-process — keep the pool warm:
          Application Pool → Start Mode = AlwaysRunning, Idle Time-out = 0
          Site → Preload Enabled = True
        See docs/architecture.md § Hosting.
      -->
      <aspNetCore processPath="dotnet"
                  arguments=".\Api.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- Override on IIS if needed; prefer setting these in IIS → Configuration Editor -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <!--
        Requires Windows feature: Application Initialization + Site Preload Enabled.
        skipManagedModules MUST be false so the init request goes through AspNetCoreModuleV2
        and starts HostedServices (order sync / Telegram). true skips ANCM → .NET never warms up.
      -->
      <applicationInitialization doAppInitAfterRestart="true" skipManagedModules="false">
        <add initializationPage="/api/v1/health" />
      </applicationInitialization>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
