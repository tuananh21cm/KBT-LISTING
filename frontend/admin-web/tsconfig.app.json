{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "types": ["vite/client"],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@drop/types": ["../packages/types/src/index.ts"],
      "@drop/types/*": ["../packages/types/src/*"],
      "@drop/utils": ["../packages/utils/src/index.ts"],
      "@drop/utils/*": ["../packages/utils/src/*"],
      "@drop/ui": ["../packages/ui/src/index.ts"],
      "@drop/ui/*": ["../packages/ui/src/*"],
      "@drop/theme": ["../packages/theme/src/index.ts"],
      "@drop/theme/*": ["../packages/theme/src/*"],
      "@drop/api-client": ["../packages/api-client/src/index.ts"],
      "@drop/api-client/*": ["../packages/api-client/src/*"],
      "@drop/orders": ["../packages/orders/src/index.ts"],
      "@drop/orders/*": ["../packages/orders/src/*"],
      "@drop/receiving-banks": ["../packages/receiving-banks/src/index.ts"],
      "@drop/receiving-banks/*": ["../packages/receiving-banks/src/*"],
      "@drop/shops": ["../packages/shops/src/index.ts"],
      "@drop/shops/*": ["../packages/shops/src/*"],
      "@drop/shop-finance": ["../packages/shop-finance/src/index.ts"],
      "@drop/shop-finance/*": ["../packages/shop-finance/src/*"],
      "@drop/company-ledger": ["../packages/company-ledger/src/index.ts"],
      "@drop/company-ledger/*": ["../packages/company-ledger/src/*"],
      "@drop/shop-tasks": ["../packages/shop-tasks/src/index.ts"],
      "@drop/shop-tasks/*": ["../packages/shop-tasks/src/*"],
      "@drop/listings": ["../packages/listings/src/index.ts"],
      "@drop/listings/*": ["../packages/listings/src/*"],
      "@drop/fulfil": ["../packages/fulfil/src/index.ts"],
      "@drop/fulfil/*": ["../packages/fulfil/src/*"],
      "@drop/dashboard": ["../packages/dashboard/src/index.ts"],
      "@drop/dashboard/*": ["../packages/dashboard/src/*"],
      "@drop/stats": ["../packages/stats/src/index.ts"],
      "@drop/stats/*": ["../packages/stats/src/*"],
      "@drop/fourseller": ["../packages/fourseller/src/index.ts"],
      "@drop/fourseller/*": ["../packages/fourseller/src/*"],
      "@drop/supplier-lists": ["../packages/supplier-lists/src/index.ts"],
      "@drop/supplier-lists/*": ["../packages/supplier-lists/src/*"],
      "@drop/product-opportunities": ["../packages/product-opportunities/src/index.ts"],
      "@drop/product-opportunities/*": ["../packages/product-opportunities/src/*"],
      "@drop/promotions": ["../packages/promotions/src/index.ts"],
      "@drop/promotions/*": ["../packages/promotions/src/*"]
    }
  },
  "include": ["src", "../packages/*/src"]
}
