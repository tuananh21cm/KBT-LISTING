{
  "manifest_version": 3,
  "name": "KBT Seller",
  "version": "1.0.0",
  "description": "Đăng nhập KBT Seller, xem thông tin shop TikTok Shop US từ seller-us.tiktok.com.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "KBT Seller — mở panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs", "sidePanel", "webRequest", "cookies", "alarms", "scripting", "webNavigation"],
  "host_permissions": [
    "https://4seller-api.kbt.global/*",
    "http://localhost:5000/*",
    "*://seller-us.tiktok.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://fonts.googleapis.com;"
  },
  "content_scripts": [
    {
      "matches": ["*://seller-us.tiktok.com/*"],
      "js": ["pageIdleHook.js", "sellerProductBridge.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["*://seller-us.tiktok.com/*"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ]
}
