{
  "manifest_version": 3,
  "name": "KBT Craper",
  "version": "1.0.0",
  "description": "Đăng nhập KBT Global, đẩy sản phẩm từ site nguồn vào draft 4Seller và xem draft mới nhất.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "KBT Craper — mở panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs", "sidePanel", "alarms"],
  "host_permissions": [
    "https://4seller-api.kbt.global/*",
    "http://localhost:5000/*",
    "https://*.shein.com/*",
    "https://shein.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://fonts.googleapis.com;"
  },
  "content_scripts": [
    {
      "matches": ["*://*.shein.com/*", "*://shein.com/*"],
      "js": ["sheinReviewCapture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.shein.com/*", "*://shein.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["*://*.shein.com/*", "*://shein.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
